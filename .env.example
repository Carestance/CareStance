# ==========================================
# Vercel Environment Variables (Frontend)
# ==========================================
# (These would be set in the Vercel dashboard, NOT here if running locally)
# NEXT_PUBLIC_API_URL=https://carestance-production.up.railway.app
# NEXT_PUBLIC_WS_URL=wss://carestance-production.up.railway.app

# ==========================================
# Railway Environment Variables (Backend)
# ==========================================
PORT=8080
ENVIRONMENT=production

# Database
DATABASE_URL=sqlite+aiosqlite:///learnloop.db
# (Use PostgreSQL in production: postgresql+asyncpg://user:pass@host/db)

# AI Providers
GROQ_API_KEY=
SARVAM_API_KEY=
CARTESIA_API_KEY=
DEEPGRAM_API_KEY=

# TURN Server (for WebRTC NAT Traversal)
TURN_SERVER_URL=turn:global.turn.twilio.com:3478?transport=udp
TURN_USERNAME=
TURN_PASSWORD=

# Session Management
# Redis is optional unless scaling beyond 1 Railway replica
# REDIS_URL=redis://localhost:6379
