{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    { "source": "/manifest.webmanifest", "destination": "/static/pwa/manifest.webmanifest" },
    { "source": "/service-worker.js", "destination": "/static/pwa/service-worker.js" },
    { "source": "/api/(.*)", "destination": "https://carestance-production.up.railway.app/api/$1" },
    { "source": "/login", "destination": "https://carestance-production.up.railway.app/login" },
    { "source": "/signup", "destination": "https://carestance-production.up.railway.app/signup" },
    { "source": "/dashboard", "destination": "https://carestance-production.up.railway.app/dashboard" },
    { "source": "/auth/(.*)", "destination": "https://carestance-production.up.railway.app/auth/$1" },
    { "source": "/BingSiteAuth.xml", "destination": "https://carestance-production.up.railway.app/BingSiteAuth.xml" },
    { "source": "/ads.txt", "destination": "https://carestance-production.up.railway.app/ads.txt" },
    { "source": "/robots.txt", "destination": "https://carestance-production.up.railway.app/robots.txt" },
    { "source": "/sitemap.xml", "destination": "https://carestance-production.up.railway.app/sitemap.xml" },
    { "source": "/static/(.*)", "destination": "/static/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript" },
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ]
}
